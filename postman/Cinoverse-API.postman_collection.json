        {
          "name": "Create Booking (Cancel Flow)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const suffix = String(Date.now()).slice(-4);",
                  "pm.collectionVariables.set('dynamicCancelSeat', 'C' + suffix);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Pending booking created for cancel test', function () {",
                  "    pm.response.to.be.json;",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.eql(true);",
                  "    pm.expect(json.data.paymentStatus).to.eql('pending');",
                  "    pm.collectionVariables.set('cancelBookingId', json.data._id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{userToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"showtimeId\": \"{{showtimeId}}\",\n  \"seats\": [\"{{dynamicCancelSeat}}\"],\n  \"paymentMethod\": \"virtual_account\"\n}"
            },
            "url": "{{baseUrl}}/api/bookings"
          }
        },
