{
  "info": {
    "name": "CINOVERSE Backend API (Kelompok 3 - PAW II)",
    "_postman_id": "a1b2c3d4-5678-4000-9000-cinoverse0003",
    "description": "Postman Collection untuk pengujian RESTful API CINOVERSE (Auth JWT, Movies, Cinemas, Showtimes, Bookings & E-Ticket).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
