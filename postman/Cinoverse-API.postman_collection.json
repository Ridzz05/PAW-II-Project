    {
      "name": "06 - Bookings & E-Ticket",
      "item": [
        {
          "name": "Create Booking (Pay Flow)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const suffix = String(Date.now()).slice(-4);",
                  "pm.collectionVariables.set('dynamicSeat', 'T' + suffix);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Booking created with pending status and CNV code', function () {",
                  "    pm.response.to.be.json;",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.eql(true);",
                  "    pm.expect(json.data.bookingCode).to.match(/^CNV-/);",
                  "    pm.expect(json.data.paymentStatus).to.eql('pending');",
                  "    pm.collectionVariables.set('bookingId', json.data._id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{userToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"showtimeId\": \"{{showtimeId}}\",\n  \"seats\": [\"{{dynamicSeat}}\"],\n  \"paymentMethod\": \"virtual_account\"\n}"
            },
            "url": "{{baseUrl}}/api/bookings"
          }
        },
        {
          "name": "Pay Booking / Simulasi Pembayaran (Auth)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Payment status changes to paid with paidAt timestamp', function () {",
                  "    pm.response.to.be.json;",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.eql(true);",
                  "    pm.expect(json.data.paymentStatus).to.eql('paid');",
                  "    pm.expect(json.data.paidAt).to.not.be.null;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
